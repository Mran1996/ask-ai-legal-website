# Ask AI Legal — environment variables (copy to .env.local and fill in values)
# Next.js loads .env.local automatically in development. Never commit real keys.

# --- Chatbot LLM providers (pick one via CHAT_MODEL_PROVIDER) ---
# Chat works without any key (FAQ fallback). Add keys for AI-powered replies.

# NVIDIA NIM (Qwen models) — keys start with nvapi-
NVIDIA_API_KEY=
# Optional alias if your Qwen key is stored separately (same nvapi- format)
QWEN_API_KEY=
NVIDIA_MODEL=qwen/qwen3-next-80b-a3b-instruct

# OpenRouter (Qwen and other models) — keys start with sk-or-v1-
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct

# OpenAI (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Which provider to use when multiple keys are set:
# nvidia | openrouter | openai
CHAT_MODEL_PROVIDER=nvidia

# --- Open Generative AI video studio (~/open-generative-ai, port 3002) ---
# Muapi powers image/video generation — NOT the same as NVIDIA/OpenRouter chat keys.
# Free key: https://muapi.ai/access-keys
MUAPI_API_KEY=

# Public site URL (used by OpenRouter HTTP-Referer header)
NEXT_PUBLIC_SITE_URL=https://askailegal.com

# --- Meta Pixel (consent-gated; set in Vercel production env too) ---
NEXT_PUBLIC_META_PIXEL_ID=

# --- PostHog (website clicks / pageviews / chat topics) ---
# Create a project at https://posthog.com → Project Settings → Project API Key
NEXT_PUBLIC_POSTHOG_KEY=
# US cloud default; EU: https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Convex ---
# Run `npx convex login` then `npx convex dev` (or `npx convex dev --configure`).
#
# Local dev (Safari may block — prefer Chrome; 1s mutation limit on local):
#   NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
#   CONVEX_DEPLOYMENT=local:local-yourname-ask_ai_legal
#
# Cloud dev (recommended — affable-hare-544 or your project):
#   NEXT_PUBLIC_CONVEX_URL=https://affable-hare-544.convex.cloud
#   NEXT_PUBLIC_CONVEX_SITE_URL=https://affable-hare-544.convex.site
#   CONVEX_DEPLOYMENT=dev:affable-hare-544
#
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
CONVEX_DEPLOYMENT=

# --- Ops intake dashboard (/ops/intakes) ---
# Set the SAME token in Convex env: npx convex env set OPS_ACCESS_TOKEN your-secret-token

# --- Cal.com call booking (see docs/CALCOM_SETUP.md) ---
# Next.js / Vercel:
# Cal.com event path — verify with: curl -sI "https://cal.com/your-username/your-event-slug"
NEXT_PUBLIC_CALCOM_INTAKE_EVENT_SLUG=ask-ai-legal/intake-call
# Convex env (not .env.local):
#   npx convex env set PUBLIC_SITE_URL https://askailegal.com
#   npx convex env set CALCOM_WEBHOOK_SECRET your-long-random-secret
#   npx convex env set RESEND_INBOUND_WEBHOOK_SECRET your-long-random-secret
#   npx convex env set COUNSEL_EMAILS "counsel@askailegal.com"
# Webhook URL: https://<deployment>.convex.site/calcom-webhook

# --- Intake email (Resend) — set in Convex env, not .env.local ---
# npx convex env set RESEND_API_KEY re_...
# npx convex env set RESEND_FROM_EMAIL "Ask AI Legal <support@askailegal.com>"
# npx convex env set GOOGLE_REVIEW_URL "https://g.page/r/YOUR_REVIEW_LINK/review"
# npx convex env set PUBLIC_SITE_URL https://askailegal.com
# Domain must be verified in Resend for support@ / notifications@ to send.

# --- Stripe (Checkout — set on Convex for webhooks/actions) ---
# npx convex env set STRIPE_SECRET_KEY sk_test_...
# npx convex env set STRIPE_WEBHOOK_SECRET whsec_...
# npx convex env set PUBLIC_SITE_URL https://askailegal.com
# Webhook URL: https://<deployment>.convex.site/stripe-webhook
# Events: checkout.session.completed
# Optional (Vercel — not required for hosted Checkout redirect):
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# See docs/PAY_QUOTE_DELIVER_FLOW.md

# --- Vercel (production / preview) ---
# Copy these to Vercel → Settings → Environment Variables.
# Do NOT use local Convex URLs on Vercel.
#
# Required:
#   NEXT_PUBLIC_CONVEX_URL=https://<deployment>.convex.cloud
#   NEXT_PUBLIC_CONVEX_SITE_URL=https://<deployment>.convex.site
#   NEXT_PUBLIC_SITE_URL=https://askailegal.com
#   CHAT_MODEL_PROVIDER=nvidia
#   NVIDIA_API_KEY=nvapi-...
#
# Optional — deploy Convex on every Vercel build:
#   CONVEX_DEPLOY_KEY=...  (Convex dashboard → Settings → Deploy Key)
#   Then set Vercel Build Command to: npm run build:vercel
#
# Full checklist: docs/VERCEL_DEPLOY.md
