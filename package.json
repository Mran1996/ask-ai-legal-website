{
  "name": "ask-ai-legal-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:convex": "npx convex dev",
    "dev:all": "npm run dev:convex & npm run dev",
    "dev:webpack": "next dev",
    "dev:reset": "lsof -ti :3000,:3001,:3002 2>/dev/null | xargs kill -9 2>/dev/null; rm -rf .next && next dev",
    "dev:prod-local": "rm -rf .next && npm run build && npm run start",
    "dev:clean": "rm -rf .next && next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "start:prod": "npm run build && next start",
    "lint": "next lint",
    "build:vercel": "npx convex deploy --cmd 'npm run build'",
    "deploy:check": "npm run build && npm run lint",
    "deploy:convex": "bash scripts/deploy-convex.sh",
    "deploy:convex:prod": "bash scripts/deploy-convex.sh --prod"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.5",
    "@ai-sdk/react": "^4.0.12",
    "ai": "^7.0.11",
    "convex": "^1.42.1",
    "convex-helpers": "^0.1.120",
    "docx": "^9.7.1",
    "lucide-react": "^0.511.0",
    "next": "^16.3.0",
    "posthog-js": "^1.407.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "stripe": "^17.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.4",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  }
}
