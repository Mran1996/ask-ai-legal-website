{
  "name": "ask-ai-legal-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:convex": "npx convex dev",
    "dev:all": "npx -y concurrently \"npm:dev:convex\" \"npm:dev\"",
    "dev:webpack": "next dev",
    "dev:reset": "npx -y kill-port 3000 3001 3002 && node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && next dev",
    "dev:prod-local": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && npm run build && npm run start",
    "dev:clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "start:prod": "npm run build && next start",
    "lint": "next lint",
    "build:vercel": "npx convex deploy --cmd 'npm run build'",
    "deploy:check": "npm run build && npm run lint",
    "deploy:convex": "bash scripts/deploy-convex.sh",
    "deploy:convex:prod": "bash scripts/deploy-convex.sh --prod"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.5",
    "@ai-sdk/react": "^4.0.12",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "ai": "^7.0.11",
    "convex": "^1.42.1",
    "convex-helpers": "^0.1.120",
    "docx": "^9.7.1",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "lucide-react": "^0.511.0",
    "next": "^16.3.0",
    "posthog-js": "^1.407.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "stripe": "^17.7.0",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@types/three": "0.186.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.4",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  }
}
